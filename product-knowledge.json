    "appStoreUrl": "https://apps.apple.com/us/app/exif-viewer-metadata-remover/id6793558409",
    "developerName": "Emil Svetlichnyy",
    "developerUrl": "https://apps.apple.com/us/developer/emil-svetlichnyy/id1875514099",
